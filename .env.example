# JWT secret key for signing tokens
# Generate a strong random string for production
JWT_SECRET=your-secret-key-change-in-production
API_KEY=your-api-key-here

# CSRF secret key (csrf-csrf double submit cookie pattern)
CSRF_SECRET=csrf-secret-change-in-production

# Cookie secret for signing cookies
COOKIE_SECRET=your-cookie-secret-change-in-production

# CORS origin (set to your production domain)
CORS_ORIGIN=http://localhost:3000

# Server port
PORT=3000

# Set to 'production' to enable secure cookie flags and __Host- prefix
NODE_ENV=development